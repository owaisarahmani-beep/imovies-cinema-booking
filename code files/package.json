{
  "name": "imovies-cinema-booking",
  "version": "1.0.0",
  "description": "Production-ready MERN stack movie ticket booking platform with real-time seat tracking and role-based administration.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "client": "npm start --prefix client",
    "client:install": "npm install --prefix client",
    "dev:full": "concurrently \"npm run dev\" \"npm run client\"",
    "seed": "node src/utils/seedData.js"
  },
  "keywords": [
    "mern",
    "movie-booking",
    "express",
    "mongodb",
    "react",
    "socket.io",
    "cinema"
  ],
  "author": "IMovies Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
